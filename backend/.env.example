# Copy this file to backend/.env and fill in rotated credentials locally.
# Never commit backend/.env or put secrets in source control.
AGROLENS_WEATHERAPI_KEY=
AGROLENS_DATA_GOV_IN_API_KEY=
AGROLENS_MANDI_ADMIN_TOKEN=
AGROLENS_SCHEMES_ADMIN_TOKEN=
AGROLENS_NEWS_ADMIN_TOKEN=
# Comma-separated browser origins for Flutter Web/local dashboard development.
AGROLENS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000,http://localhost:7357
# Optional password reset delivery. Without SMTP configuration, reset requests
# remain generic and no reset token is created or disclosed.
AGROLENS_SMTP_HOST=
AGROLENS_SMTP_PORT=465
AGROLENS_SMTP_USERNAME=
AGROLENS_SMTP_PASSWORD=
AGROLENS_AUTH_FROM_EMAIL=
AGROLENS_AUTH_PUBLIC_BASE_URL=
