{
  "contract_version": "1.0",
  "description": "Standard output format for AgroLens on-device crop disease and pest inference",
  "input": {
    "image": {
      "format": "RGB",
      "source": "camera_or_gallery",
      "preprocessing": {
        "resize": "model_defined",
        "normalization": "model_defined"
      }
    }
  },
  "output": {
    "prediction_id": "string",
    "crop": "string",
    "disease_label": "string",
    "confidence": "number",
    "top_predictions": [
      {
        "label": "string",
        "confidence": "number"
      }
    ],
    "is_low_confidence": "boolean",
    "model_version": "string",
    "inference_timestamp": "ISO-8601 datetime"
  },
  "rules": [
    "Confidence must be between 0.0 and 1.0",
    "Low-confidence predictions must not be presented as confirmed diagnoses",
    "Disease labels must match contracts/disease_labels.json",
    "The mobile app must display remedies based on the predicted label"
  ]
}